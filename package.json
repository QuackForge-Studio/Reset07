{
  "name": "reset07-brand-kit",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "RESET//07 \u2014 brand system, UI kit, and internal guidelines for a top-down neon sci-fi action game trapped in a seven-minute loop.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "generate:icons": "node scripts/generate-icons.mjs",
    "optimize:art": "node scripts/optimize-art.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:narrow": "node scripts/narrow-check.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "test:smoke": "npm run build:e2e && node scripts/game-smoke.mjs",
    "test:e2e": "npm run test:smoke",
    "test:production": "npm run build && node scripts/game-smoke.mjs --target=production",
    "test:soak": "npm run build:e2e && node scripts/game-smoke.mjs --live-loop",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:smoke && npm run build",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.0.20",
    "@fontsource/chakra-petch": "^5.0.19",
    "@fontsource/ibm-plex-mono": "^5.0.20",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "sharp": "^0.33.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
